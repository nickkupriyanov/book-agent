      "final_state": {"run_status": "completed", "answer_contains": ["Дюна"]},
      "max_steps": 3,
      "fake_responses": [
        {"text": "", "tool_calls": [{"id": "search-dune-1", "name": "search_books", "arguments": {"query": "Дюна", "limit": 5}}]},
        {"text": "Нашёл «Дюну».", "tool_calls": []}
      ]
    },
    {
      "id": "search-1984",
      "input": "Найди книгу 1984",
