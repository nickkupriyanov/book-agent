DATABASE_URL=sqlite:///./book_agent.db
# PostgreSQL alternative: postgresql+psycopg://book_agent:book_agent@localhost:5432/book_agent
DEMO_USER_ID=00000000-0000-0000-0000-000000000001
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=30.0
AGENT_MAX_STEPS=5
CATALOG_PROVIDER=open_library
OPEN_LIBRARY_BASE_URL=https://openlibrary.org
OPEN_LIBRARY_USER_AGENT=BookAgentLearning/0.1
OPEN_LIBRARY_TIMEOUT_SECONDS=3.0
OPEN_LIBRARY_MAX_RETRIES=1
OPEN_LIBRARY_RETRY_DELAY_SECONDS=0.1
CATALOG_CACHE_TTL_SECONDS=300
CATALOG_CACHE_MAX_ENTRIES=128
